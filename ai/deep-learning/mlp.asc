===== impl
py: https://github.com/pytorch/pytorch/blob/main/torch/nn/modules/activation.py

[source, cpp]
.https://github.com/pytorch/pytorch/blob/main/aten/src/ATen/native/Activation.cpp
----
Tensor relu(const Tensor & self) {
  TORCH_CHECK(self.scalar_type() != at::kBool, "Boolean inputs not supported for relu");
  return at::clamp_min(self, 0);
}

Tensor & relu_(Tensor & self) {
  TORCH_CHECK(self.scalar_type() != at::kBool, "Boolean inputs not supported for relu");
  return at::clamp_min_(self, 0);
}
----

